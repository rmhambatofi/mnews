# ---- Général ----
TZ=Europe/Paris
# Dossier des logs (relatif à la racine du projet)
LOG_DIR=logs

# ---- Base de données MySQL (cPanel > Bases de données MySQL) ----
# Format : mysql+pymysql://UTILISATEUR:MOTDEPASSE@localhost/NOM_BASE?charset=utf8mb4
DATABASE_URL=mysql+pymysql://user:password@localhost/mnews?charset=utf8mb4

# ---- Claude ----
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
# Effort de réflexion pour la sélection et la rédaction (low|medium|high|xhigh|max)
CLAUDE_EFFORT_SELECT=medium
CLAUDE_EFFORT_WRITE=high

# ---- Email (SMTP o2switch) ----
SMTP_HOST=mail.manitra.fr
SMTP_PORT=465
SMTP_SSL=1
SMTP_USER=no-reply@manitra.fr
SMTP_PASSWORD=
MAIL_FROM=no-reply@manitra.fr
MAIL_FROM_NAME=News IA
MAIL_TO=manitra.harijaona@gmail.com
# Destinataire des alertes en cas d'échec
ALERT_TO=manitra.harijaona@gmail.com

# ---- Interface web ----
ADMIN_PASSWORD=changez-moi
# Longue chaîne aléatoire : python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# Jeton pour déclencher une génération via URL : /trigger?token=...
TRIGGER_TOKEN=

# ---- Collecte ----
# Fenêtre de fraîcheur des articles (heures)
LOOKBACK_HOURS=36
# Nombre maximum de sujets dans la newsletter (hors dépôts GitHub)
MAX_STORIES=8
# Nombre maximum de dépôts GitHub dans la section étoiles
MAX_REPOS=5
# Jours d'historique utilisés pour éviter les répétitions
HISTORY_DAYS=10
# Passerelle RSS pour les comptes X ({handle} est remplacé par le pseudo)
X_RSS_TEMPLATE=https://nitter.net/{handle}/rss
# Jeton GitHub optionnel (augmente la limite de requêtes API)
GITHUB_TOKEN=
